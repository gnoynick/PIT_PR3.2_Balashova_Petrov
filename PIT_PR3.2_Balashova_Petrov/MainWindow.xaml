<Window x:Class="PIT_PR3._2_Balashova_Petrov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PIT_PR3._2_Balashova_Petrov"
        mc:Ignorable="d"
        Title="Калькулятор" Height="145" Width="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="48*" />
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox Name="Operand1" Grid.Column="0" Grid.Row="0" Margin="6,17,14,3" FontSize="16" FontFamily="Times New Roman" TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <TextBox Name="Operand2" Grid.Column="0" Grid.Row="1" Margin="7,19,13,6" FontSize="16" FontFamily="Times New Roman" TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <Label Content="Операнд 1" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-5,0,0" FontFamily="Times New Roman" FontSize="14" />
        <Label Content="Операнд 2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,47,0,0" Grid.RowSpan="2" FontFamily="Times New Roman" FontSize="14" />

        <GroupBox Header="Операция" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="9,10,11,10" FontFamily="Times New Roman" FontSize="14">
            <StackPanel>
                <RadioButton Name="Add" Content="+" FontSize="14" />
                <RadioButton Name="Subtract" Content="-" FontFamily="Times New Roman" FontSize="14" />
                <RadioButton Name="Multiply" Content="*" />
                <RadioButton Name="Divide" Content="/" />
            </StackPanel>
        </GroupBox>

        <Button Name="CalculateButton" Content="Вычислить" Grid.Column="2" Grid.Row="1" Margin="6,19,6,6" Click="CalculateButton_Click"/>
        <TextBox Name="ResultBox" Grid.Column="2" Margin="7,17,5,3" IsReadOnly="True" FontSize="16" FontFamily="Times New Roman" TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <Label Content="Результат" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-6,0,0" FontSize="14" FontFamily="Times New Roman" />
    </Grid>
</Window>
